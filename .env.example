# Copy this file to ".env" (same folder as run.ps1 / requirements.txt) and
# fill in the values you need. The server loads it automatically on startup
# via python-dotenv -- no manual `$env:` setting required, and no need to
# re-set anything each time you open a new terminal.
#
# Full field-by-field documentation lives in the docstring at the top of
# app/config.py -- read it before changing anything non-obvious. This file
# is the minimal, non-corrupted template; app/config.py is the source of truth.

# ---------------------------------------------------------------
# Storage
# ---------------------------------------------------------------
# "mirage" (default, real deployment) or "disk" (offline dev/tests, no
# credentials needed, writes to LOCAL_BUCKET_ROOT). Both go through the same
# mirage-ai Workspace code path -- "disk" just mounts a DiskResource instead
# of an S3Resource, so what runs locally is the code that ships.
# ("s3" is accepted as an alias for "mirage", "local" for "disk".)
STORAGE_BACKEND=mirage
LOCAL_BUCKET_ROOT=./local_bucket

# Required when STORAGE_BACKEND=mirage.
MIRAGE_S3_BUCKET=
MIRAGE_S3_REGION=
# Only set this if you're on an S3-compatible gateway (e.g. Qiniu Kodo)
# instead of AWS S3 itself. Leave blank for real AWS S3.
MIRAGE_S3_ENDPOINT_URL=
MIRAGE_S3_ACCESS_KEY_ID=
MIRAGE_S3_SECRET_ACCESS_KEY=
MIRAGE_S3_SESSION_TOKEN=
MIRAGE_S3_PROFILE=
# "true" for non-AWS gateways that need path-style addressing (e.g. Qiniu);
# "false" for real AWS S3.
MIRAGE_S3_PATH_STYLE=false
MIRAGE_S3_KEY_PREFIX=memory_backend/

# Must stay 0. A higher TTL returns stale directory listings when another
# process writes, and _rebuild_manifest replaces the index with whatever a
# listing returns -- so a stale listing can delete entries for entities that
# still exist.
MIRAGE_INDEX_TTL_SECONDS=0
# Reuses one TLS connection instead of a fresh handshake per operation --
# roughly 10x faster against a remote endpoint. Keep true.
MIRAGE_REUSE_CONNECTIONS=true
# Skips an extra read-before-write network round trip on every entity write.
# Safe within one process (app/graph/store.py's per-entity lock covers a
# same-process race); NOT safe across multiple server processes writing the
# same entity concurrently -- set back to true if you run more than one
# worker against the same bucket.
MIRAGE_VERIFY_CONDITIONAL_WRITES=true

# "buffered" (default) or "sync". Buffered keeps the manifest/ops-log in
# memory and flushes on a timer, collapsing N entity writes into far fewer
# PUTs. Set "sync" for either if more than one process writes the same user.
MANIFEST_WRITE_MODE=buffered
OPS_LOG_WRITE_MODE=buffered
FLUSH_INTERVAL_SECONDS=2.0
FLUSH_MAX_PENDING=100

# "companion" (default): the .okf.md carries only the fields the OKF spec
#   defines and points at a sibling .okf.json for facts/relations/metadata.
# "frontmatter": everything in one self-contained file.
# Reads accept either regardless of which wrote the file, so switching needs
# no migration for new writes (existing files keep their old shape until
# rewritten -- see scripts/migrate_okf.py).
OKF_MODE=companion

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------
# "token" (default) requires AUTH_TOKENS or AUTH_ADMIN_TOKEN; the app refuses
# to start without one, so an unauthenticated API cannot ship by accident.
# "off" disables auth and warns loudly at startup. Local development only.
AUTH_MODE=token

# token:user_id pairs, comma-separated. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Two tokens may map to the same user, which is how you rotate without downtime.
AUTH_TOKENS=replace-me:demo

# Optional. May access ANY user_id -- for cross-tenant maintenance jobs.
# AUTH_ADMIN_TOKEN=

# "false" (default) lets any authenticated user create a wiki (needed for
# auto-creation on write). "true" restricts it to admins.
WIKI_CREATE_REQUIRES_ADMIN=false

# Set AUTH_SECRET to enable username/password login, then create accounts:
#   python scripts/manage_users.py add alice
# POST /v1/auth/login exchanges a username+password for a session token, used
# as a bearer credential like a static one. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_SECRET=

# Session lifetime in hours. Keep it short: sessions are stateless, so an
# individual token cannot be revoked before expiry -- rotating AUTH_SECRET
# is the only bulk-revocation mechanism.
AUTH_SESSION_HOURS=12

# Login throttle. Without it, passwords are brute-forceable at network speed.
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_WINDOW_SECONDS=300

# ---------------------------------------------------------------
# LLM extraction layer (POST /extract, chat)
# ---------------------------------------------------------------
# Optional: without a key the rest of the service works normally and
# /extract returns 503.
# DEEPSEEK_API_KEY=

# Any OpenAI-compatible endpoint works (OpenAI, Together, Ollama, vLLM) by
# changing these two.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# Extraction from a long conversation produces a lot of JSON; raise this
# further if you extract very long transcripts (the plan reports when it
# truncates).
LLM_MAX_TOKENS=10000

# Assessor verdict a conversation must reach before a model call is spent on
# it. "review" (default) includes borderline text; "store" is stricter and
# cheaper.
LLM_MIN_DECISION=review

# ---------------------------------------------------------------
# Auto-capture (background, no-button ingestion of journaled sessions)
# ---------------------------------------------------------------
AUTO_CAPTURE_ENABLED=false
AUTO_CAPTURE_TIME=22:00
AUTO_CAPTURE_TZ=
# 0 (default) = capture the SAME day's journal, same night's run.
# 1 = capture yesterday's (the prior day's journal, final once it has ended).
AUTO_CAPTURE_LOOKBACK_DAYS=0
# On startup, walk back this many days and capture any not-yet-processed day
# (idempotent -- the cursor dedupes, nothing is ever double-stored). 0 = no
# startup backfill.
AUTO_CAPTURE_BACKFILL_DAYS=7
# When true (and AUTO_CAPTURE_ENABLED=true), also generates a daily "diary"
# per user after each capture run.
DIARY_ENABLED=true

# ---------------------------------------------------------------
# Conflict detection (Semantica-backed)
# ---------------------------------------------------------------
# "false" (default) or "true". When true, entity writes run conflict
# detection; contradictions are stored as OKF conflict records and the write
# still lands (flag-only) unless a resolution strategy is set below.
CONFLICT_CHECK_ENABLED=false
# One of: most_recent | highest_confidence | voting | credibility_weighted |
# first_seen. Empty (default) = flag-only, never blocks a write.
CONFLICT_RESOLUTION_STRATEGY=

# ---------------------------------------------------------------
# Semantic search fallback (optional, off by default)
# ---------------------------------------------------------------
# Requires the optional FlagEmbedding package and the bge-m3 model
# downloaded locally (see app/graph/embeddings.py). Degrades to lexical-only
# search (never crashes) if either is missing.
EMBEDDING_ENABLED=false
EMBEDDING_SIMILARITY_FLOOR=0.5
