# DREAM data directory. Each tenant/agent/user remains isolated below this root.
DREAM_HOME=~/.dream

# Redis Session Context used by the company Agent integration.
DREAM_REDIS_URL=redis://127.0.0.1:6379/0
DREAM_REDIS_SESSION_TTL_SECONDS=43200
DREAM_REDIS_HISTORY_TURNS=10
DREAM_CONTEXT_WINDOW_TOKENS=128000
DREAM_HEADROOM_TRIGGER_RATIO=0.65
DREAM_HEADROOM_MAX_MESSAGES=100
DREAM_HEADROOM_MAX_SESSION_SECONDS=14400

# External official Headroom compression service.
# production requires HEADROOM_SERVICE_URL; development allows no-op fallback.
DREAM_ENV=development
DREAM_OPTIMIZATION_SCOPE_SECRET=replace-with-a-production-secret
HEADROOM_SERVICE_URL=http://127.0.0.1:8787
HEADROOM_SERVICE_API_KEY=
HEADROOM_SERVICE_TIMEOUT_SECONDS=300
HEADROOM_CCR_TTL_SECONDS=43200
# Forwarded unchanged to /v1/compress; DREAM does not select service internals.
HEADROOM_COMPRESSION_MODEL=gpt-4o

# Background Review: deterministic (offline/testing) or openai.
DREAM_REVIEW_BACKEND=openai
DREAM_REVIEW_MODEL=your-openai-compatible-model
DREAM_REVIEW_BASE_URL=https://api.openai.com/v1
DREAM_LLM_API_KEY=your-secret
DREAM_REVIEW_MAX_COMPLETION_TOKENS=4096
# Adaptive per-user Background Review thresholds. Any one condition is enough.
DREAM_REVIEW_IDLE_HOURS=2
DREAM_REVIEW_MAX_BATCH_TOKENS=16000
DREAM_REVIEW_MAX_BATCH_EVENTS=20
DREAM_REVIEW_MAX_WAIT_HOURS=24
DREAM_TIMEZONE=Asia/Shanghai
DREAM_CURATOR_DAILY_HOUR=3
# auto tries tool calling once, then strict JSON; tools/json force one format.
DREAM_LLM_STRUCTURED_MODE=auto
# Per provider request; the ordinary dream transaction has its own total budget.
DREAM_LLM_TIMEOUT_SECONDS=90
# true honors HTTP(S)_PROXY/SSL_CERT_FILE; false uses a direct isolated client.
DREAM_LLM_TRUST_ENV=true
DREAM_DEADLINE_SECONDS=300

# AI decision-card and user-profile Curators.
# inherit reuses the Background Review provider, model, endpoint, and key.
DREAM_CURATOR_BACKEND=inherit
DREAM_CURATOR_CONSOLIDATE=false
DREAM_CURATOR_CONSOLIDATE_INTERVAL_HOURS=168
DREAM_CURATOR_CONSOLIDATE_MIN_IDLE_HOURS=2
DREAM_CURATOR_MODEL=
DREAM_CURATOR_BASE_URL=
DREAM_CURATOR_LLM_API_KEY=
DREAM_CURATOR_MAX_COMPLETION_TOKENS=3000

# Character.AI manual writeback artifact limits.
DREAM_CHARACTER_DEFINITION_LIMIT=3200
DREAM_USER_PERSONA_LIMIT=1200
# Phase one: false. After the first reviewed writeback is active: true.
# When true, /v1/tasks/start returns 409 until the latest event is active.
DREAM_VALIDATION_REQUIRE_ACTIVE_WRITEBACK=false

# Optional read-only pull source for completed Internship conversations.
DREAM_INTERNSHIP_SOURCE_ENABLED=false
DREAM_INTERNSHIP_SOURCE_URL=http://127.0.0.1:8000/v1/memory/dream-export
DREAM_INTERNSHIP_SOURCE_API_KEY=
DREAM_INTERNSHIP_SOURCE_TENANT_ID=enterprise-a
DREAM_INTERNSHIP_SOURCE_AGENT_ID=service-agent
DREAM_INTERNSHIP_SOURCE_BATCH_SIZE=100
DREAM_INTERNSHIP_SOURCE_TIMEOUT_SECONDS=15
DREAM_INTERNSHIP_SOURCE_INTERVAL_SECONDS=300
