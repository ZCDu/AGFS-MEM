# Copy this file to ".env" (same folder as run.sh / requirements.txt) and
# fill in the values you need. The server loads it automatically on
# startup via python-dotenv — no manual `$env:` setting required, and no
# need to re-set anything each time you open a new terminal.
#
# Only relevant to whichever STORAGE_BACKEND you pick — the other sections
# can stay blank/commented.
#
# Requires: pip install python-dotenv  (already in requirements.txt)
#
# Note: python-dotenv does NOT override variables you've already set with
# $env: in your current shell session — if something still looks like the
# old value, check you don't have a leftover $env: override active.

# ---------------------------------------------------------------
# General
# ---------------------------------------------------------------

# "local", "s3", or "mirage"
STORAGE_BACKEND=mirage

# ---------- authentication ----------
# "token" (default) requires AUTH_TOKENS or AUTH_ADMIN_TOKEN; the app refuses
# to start without one, so an unauthenticated API cannot ship by accident.
# "off" disables auth and warns at startup. Local development only.
AUTH_MODE=token

# token:user_id pairs, comma-separated. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Two tokens may map to the same user, which is how you rotate without downtime.
AUTH_TOKENS=replace-me:demo

# Optional. May access ANY user_id — for cross-tenant maintenance jobs.
# AUTH_ADMIN_TOKEN=

# ---------- username/password login ----------
# Set AUTH_SECRET to enable it, then create accounts:
#   python scripts/manage_users.py add alice
# POST /v1/auth/login exchanges a username and password for a session token,
# used as a bearer credential like a static one.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_SECRET=

# Session lifetime. Keep it short: sessions are stateless, so an individual
# token cannot be revoked before expiry. Rotating AUTH_SECRET ends all of them.
AUTH_SESSION_HOURS=12

# Login throttle. Without it, passwords are brute-forceable at network speed.
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_WINDOW_SECONDS=300

# ---------------------------------------------------------------
# STORAGE_BACKEND=disk  (local filesystem, development)
# ---------------------------------------------------------------

LOCAL_BUCKET_ROOT=./local_bucket


# ---------------------------------------------------------------
# STORAGE_BACKEND=s3  (plain boto3, real AWS S3)
# ---------------------------------------------------------------

S3_BUCKET=
S3_PREFIX=

# Validate the bucket before starting the server:
#   python scripts/s3_preflight.py --bucket $S3_BUCKET --prefix $S3_PREFIX
#
# The IAM policy MUST include s3:ListBucket on the bucket ARN, not just
# s3:GetObject/PutObject on the object ARN. Without it S3 returns 403
# instead of 404 for absent keys and every existence check fails. See
# the IAM policy in README.md.
#
# Running more than one server process against the same bucket? Set
# MANIFEST_WRITE_MODE=sync below — the buffered manifest is per-process.

AWS_DEFAULT_REGION=us-east-1

# boto3 also needs standard AWS credentials available — either set these,
# or use `aws configure` / an IAM role instead and leave these blank:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=


# ---------------------------------------------------------------
# STORAGE_BACKEND=mirage  (via mirage-ai, same lib the old repo used)
# ---------------------------------------------------------------

MIRAGE_S3_BUCKET=
MIRAGE_S3_REGION=
# Only set this if you're on an S3-compatible gateway (e.g. Qiniu Kodo)
# instead of AWS S3 itself. Leave blank for real AWS S3.
MIRAGE_S3_ENDPOINT_URL=
MIRAGE_S3_ACCESS_KEY_ID=
MIRAGE_S3_SECRET_ACCESS_KEY=
MIRAGE_S3_SESSION_TOKEN=
MIRAGE_S3_PROFILE=
# "true" or "false"
MIRAGE_S3_PATH_STYLE=false
MIRAGE_S3_KEY_PREFIX=memory_backend/


# ---------- LLM extraction layer (POST /extract) ----------
# Turns raw conversation into entities, facts and relations. Optional: without
# a key the rest of the service works normally and /extract returns 503.
# DEEPSEEK_API_KEY=

# Any OpenAI-compatible endpoint works — OpenAI, Together, Ollama, vLLM —
# by changing these two.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

LLM_MAX_TOKENS=8000
# Extraction from a long conversation produces a lot of JSON. At 2000 the
# reply was cut off mid-object and failed to parse. Raise further for very
# long transcripts; the plan reports when it truncates.

# Assessor verdict a conversation must reach before a model call is spent on
# it. "review" includes borderline text; "store" is stricter and cheaper.
LLM_MIN_DECISION=review
