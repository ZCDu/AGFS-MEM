# ===== Required =====
# Embedding service (DashScope compatible-mode API)
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=sk-your-key-here

# LLM service (OpenAI-compatible HTTP API)
LLM_API_URL=http://localhost:8081/v1
LLM_API_KEY=sk-local

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=elastic
ES_INDEX_NAME=mem0
# ES_USE_SSL=false
# ES_VERIFY_CERTS=false

# ===== Optional (defaults shown below) =====
# Redis
# REDIS_URL=redis://localhost:6379/0

# Embedding
# EMBEDDING_DIM=1024

# LLM
# LLM_MODEL=qwen-plus

# Session
# SESSION_TTL_SECONDS=86400
# ARCHIVED_ROUNDS_MAX=50
# RECENT_ROUNDS_FULL=3

# Thresholds
# RELEVANCE_THRESHOLD=0.35

# Retrieval
# MEM_RETRIEVAL_TOP_K=10

# Local storage
# STORAGE_BACKEND=local
# STORAGE_BASE_PATH=~/memory_system_data
# MIRAGE_STORAGE_PATH=~/memory_mirage_data
